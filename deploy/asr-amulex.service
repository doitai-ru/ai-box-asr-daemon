[Unit]
Description=ASR amulex (native, GPU) — gigaam-v3-rnnt + T-one + диаризация
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/asr-amulex-it

# --- Прод-конфиг (снят с Docker-контейнера asr-amulex) ---
Environment=HOST=0.0.0.0
Environment=PORT=49153
Environment=PROVIDER=CUDA
Environment=MODEL_NAME=gigaam-v3-rnnt
Environment=STREAM_WITH_GPU=1
Environment=VAD_WITH_GPU=1
Environment=PUNCTUATE_WITH_GPU=1
Environment=CAN_DIAR=1
Environment=DIAR_WITH_GPU=1
Environment=MAX_OVERLAP_DURATION=25
Environment=BETWEEN_WORDS_PERCENTILE=82
Environment=IS_PROD=1
Environment=LOGGING_LEVEL=INFO
# Модели лежат в {repo}/models (HF_HOME -> сюда же); tone — в models/tone
Environment=HF_HOME=/opt/asr-amulex-it/models
Environment=TONE_DECODER=beam_search
# T-one: пул процессов под kenlm-декод (стейдж B) + потоки под акустический forward (стейдж A).
# Декод вынесен в пул (6 проц.), но боттлнек 12-14 стримов переехал на однопоточный forward —
# поднимаем forward-воркеры до 6 (развязка reader/inferer защищает keepalive независимо от скорости).
Environment=TONE_DECODE_PROCS=6
Environment=TONE_INFER_WORKERS=6
# GPU-профайлер дефолтно ВЫКЛ; включается на лету: POST /api/v1/admin/gpu-profile {"enabled":true}

# Миграции БД на старте (идемпотентно, не блокируют ASR). PYTHONPATH= чтобы локальная
# папка alembic/ не затеняла пакет alembic.
ExecStartPre=/bin/sh -c 'cd /opt/asr-amulex-it && PYTHONPATH= /opt/asr-amulex-it/venv/bin/alembic upgrade head || echo "alembic upgrade skipped"'
ExecStart=/opt/asr-amulex-it/venv/bin/python main.py

Restart=always
RestartSec=5
# Бэкстоп: если процессы не погасли за 30с — systemd шлёт SIGKILL всему cgroup
# (а не ждёт дефолтные 90с). Воркеры decode-пула гасятся раньше (сброс сигналов + terminate).
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
