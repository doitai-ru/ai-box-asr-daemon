# Локальный ТЕСТОВЫЙ образ новой архитектуры (api/v1 + services): собирается из рабочего
# дерева (COPY), модели монтируются с хоста. Прод-образ - Docker/Dockerfile.
#
# Сборка из КОРНЯ репозитория:
#   CPU:  docker build -f Docker/Dockerfile.local -t asr-local .
#   GPU:  docker build -f Docker/Dockerfile.local --build-arg PROVIDER=CUDA -t asr-local .
FROM python:3.12-slim-bullseye

RUN apt-get update && apt-get install -y \
    git git-lfs ffmpeg curl ca-certificates jq \
    && rm -rf /var/lib/apt/lists/*
RUN git lfs install

# T-one опционален: build-essential/cmake/libboost/libeigen (для kenlm) только при WITH_TONE=1
ARG WITH_TONE=1
RUN if [ "$WITH_TONE" = "1" ] || [ "$WITH_TONE" = "true" ]; then \
        apt-get update && \
        apt-get install -y build-essential cmake libboost-all-dev libeigen3-dev && \
        rm -rf /var/lib/apt/lists/* ; \
    fi

# Провайдер: CPU (по умолч.) | CUDA. Для CUDA меняем onnxruntime -> onnxruntime-gpu + cupy.
ARG PROVIDER=CPU
COPY requirements.txt /tmp/req.txt
RUN if [ "$PROVIDER" = "CUDA" ] || [ "$PROVIDER" = "TENSORRT" ]; then \
        sed -i 's#^onnxruntime\s*$#onnxruntime-gpu[cuda,cudnn]==1.23.2#' /tmp/req.txt && \
        echo "cupy-cuda12x==13.5.1" >> /tmp/req.txt ; \
    fi
RUN pip install --no-cache-dir -r /tmp/req.txt

# T-one (потоковый путь /api/v1/asr/ws-stream) — только при WITH_TONE=1
RUN if [ "$WITH_TONE" = "1" ] || [ "$WITH_TONE" = "true" ]; then \
        pip install --no-cache-dir --no-deps "git+https://github.com/voicekit-team/T-one.git" && \
        pip install --no-cache-dir pyctcdecode kenlm miniaudio ; \
    fi

# Для CUDA фиксируем cuDNN как в проде
RUN if [ "$PROVIDER" = "CUDA" ] || [ "$PROVIDER" = "TENSORRT" ]; then \
        pip install --no-cache-dir --force-reinstall nvidia-cudnn-cu12==9.6.0.74 ; \
    fi

# Код приложения - из локального рабочего дерева (.dockerignore исключает venv/models/.git)
COPY . /ASR_FastAPI_WS_RU/

# Каталоги, обязательные на старте (логи; иначе TimedRotatingFileHandler падает)
RUN mkdir -p /ASR_FastAPI_WS_RU/logs /ASR_FastAPI_WS_RU/local_asr/to_asr /ASR_FastAPI_WS_RU/local_asr/after_asr

# Запекаем модель T-one в {HF_HOME}/tone (скачиваем ЗДЕСЬ, в образе; рантайм только грузит from_local).
# Отдельный каталог tone (не hub) — чтобы бинд-маунт hub его не перекрывал.
# greedy -> только model.onnx (~150 МБ); beam_search -> ещё kenlm.bin (~5.5 ГБ).
ARG TONE_DECODER=beam_search
ENV TONE_DECODER=${TONE_DECODER}
RUN if [ "$WITH_TONE" = "1" ] || [ "$WITH_TONE" = "true" ]; then \
        HF_HOME=/tmp/hfcache python3 -c "import os; from tone import StreamingCTCPipeline; d='/ASR_FastAPI_WS_RU/models/tone'; os.makedirs(d, exist_ok=True); StreamingCTCPipeline.download_from_hugging_face(d, only_acoustic=('$TONE_DECODER'=='greedy'))" && \
        rm -rf /tmp/hfcache ; \
    fi

ENV PYTHONPATH=/ASR_FastAPI_WS_RU \
    HF_HOME=/ASR_FastAPI_WS_RU/models \
    IS_PROD=1 \
    LOGGING_LEVEL=INFO

WORKDIR /ASR_FastAPI_WS_RU
ARG PORT=49153
ENV PORT=${PORT}
EXPOSE ${PORT}
# На старте применяем миграции БД (идемпотентно). Если БД недоступна — не блокируем ASR.
# PYTHONPATH= для alembic: локальная папка alembic/ не должна затенять пакет alembic
CMD ["sh", "-c", "PYTHONPATH= alembic upgrade head || echo 'alembic upgrade skipped'; exec python3 main.py"]
